# Product identity for release builds. Sourced by macos/build.sh and
# macos/package.sh; every user-visible name, the publisher line and the
# installer texts come from here. Change the name in this file only.

PRODUCT_NAME_KO="매무시"
PRODUCT_NAME_EN="Maimusi"
# One-line description shown under the name in the installer.
TAGLINE_KO="한글 자동 띄어쓰기 입력기"
TAGLINE_EN="Korean input method with automatic spacing"
# Name of the spacing engine shown in settings and the installer.
ENGINE_NAME_KO="찰떡"
ENGINE_NAME_EN="CharTec"
# Installer, zip and folder names (ASCII, no spaces).
PRODUCT_FILE="Maimusi"
# Installed bundle: /Library/Input Methods/<APP_BUNDLE>. The executable inside
# stays "HangulSpacing" (process name only, never shown to users).
APP_BUNDLE="Maimusi.app"

PUBLISHER="Sebansios"
# Publisher as shown to Korean users (Windows installer, Apps & Features).
PUBLISHER_KO="세반시옷"
WEBSITE="https://sebansios.com"
SUPPORT_EMAIL="admin@sebansios.com"
# Signed update manifests the apps check for new versions (docs/UPDATES.md).
# Public keys: packaging/update-keys.json.
UPDATE_URL_MACOS="https://dl.sebansios.com/maimusi/update/macos.json"
UPDATE_URL_WINDOWS="https://dl.sebansios.com/maimusi/update/windows.json"
COPYRIGHT_YEAR="2026"

# Never changes after the first public release: macOS keys the input source,
# its settings and the installer receipt to this identifier.
BUNDLE_ID="com.sebansios.inputmethod.Maimusi"
# Identifier and bundle used by builds before 0.5.0; the installer cleans them up.
LEGACY_BUNDLE_ID="org.hangulspacing.inputmethod.HangulSpacing"
LEGACY_APP_BUNDLE="HangulSpacing.app"

