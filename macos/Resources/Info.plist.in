<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleExecutable</key>
	<string>HangulSpacing</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@NAME_EN@</string>
	<key>CFBundleDisplayName</key>
	<string>@NAME_KO@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>HSEngineName</key>
	<string>@ENGINE_KO@</string>
	<key>HSReleaseLabel</key>
	<string>@RELEASE_LABEL@</string>
	<key>HSWebsite</key>
	<string>@WEBSITE@</string>
	<key>HSSupportEmail</key>
	<string>@SUPPORT_EMAIL@</string>
	<key>HSUpdateURL</key>
	<string>@UPDATE_URL@</string>
	<key>NSHumanReadableCopyright</key>
	<string>@COPYRIGHT@</string>
	<key>InputMethodConnectionName</key>
	<string>@BUNDLE_ID@_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>HangulSpacingInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>HangulSpacingInputController</string>
	<key>TISIntendedLanguage</key>
	<string>ko</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hang</string>
	</array>
	<key>tsInputMethodIconFileKey</key>
	<string>MenuIconTemplate.tiff</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>@BUNDLE_ID@.dubeolsik</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>@BUNDLE_ID@.dubeolsik</string>
				<key>TISIntendedLanguage</key>
				<string>ko</string>
				<key>tsInputModeScriptKey</key>
				<string>smKorean</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<false/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>MenuIconTemplate.tiff</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>MenuIconTemplate.tiff</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>MenuIconTemplate.tiff</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>@BUNDLE_ID@.dubeolsik</string>
		</array>
	</dict>
</dict>
</plist>
